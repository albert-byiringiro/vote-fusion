{
  "name": "vote-fusion",
  "version": "1.0.0",
  "description": "Make decisions with friends via ranked voting!",
  "private": true,
  "workspaces": [
    "client",
    "server",
    "shared"
  ],
  "scripts": {
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "client:dev": "npm run dev --workspace=client",
    "client:build": "npm run build --workspace=client",
    "server:dev": "wait-on tcp:6379 && npm run start:dev --workspace=server",
    "server:build": "npm run build --workspace=server",
    "shared:build": "npm run build --workspace=shared",
    "dev": "concurrently 'npm run docker:up' 'npm:server:dev' 'npm:client:dev'",
    "build": "npm run shared:build && npm run server:build && npm run client:build",
    "test": "npm run test --workspaces",
    "lint": "npm run lint --workspaces",
    "clean": "rimraf **/dist **/build",
    "storybook": "npm run storybook --workspace=client",
    "stop": "npm run docker:down"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/albert-byiringiro/vote-fusion.git"
  },
  "keywords": [
    "ts",
    "react",
    "nestjs",
    "socketjs"
  ],
  "author": "Albert Byiringiro",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^8.2.2",
    "rimraf": "^5.0.0",
    "typescript": "^4.9.5",
    "eslint": "^8.57.1",
    "prettier": "^3.0.0",
    "wait-on": "^6.0.1"
  }
}